# Database
# Local Docker default for .env:
DATABASE_URL="postgresql://bourse:bourse@localhost:5432/bourse"
# Production example:
# DATABASE_URL="postgresql://bourse:<password>@postgres:5432/bourse"

# Auth
# generer : openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# AI credentials are entered per user in Settings and encrypted in the database.
# Use a stable random secret (32+ characters). If omitted, AUTH_SECRET is used.
# Back up this secret; rotating it requires users to re-enter their API keys.
AI_ENCRYPTION_KEY=""
# Additional API origins trusted by the server operator, comma-separated.
# Include the scheme and optional port, but no path. Redirects are rejected.
AI_ALLOWED_API_ORIGINS=""
