# Database
# Local Docker default for .env:
DATABASE_URL="postgresql://bourse:bourse@localhost:5432/bourse"
# Production example:
# DATABASE_URL="postgresql://bourse:<password>@postgres:5432/bourse"

# Auth
# generer : openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# AI providers
# At least one provider should be configured for the agent features.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
NVIDIA_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
